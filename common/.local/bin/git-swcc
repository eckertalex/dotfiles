#!/usr/bin/env bash

# Create a branch from a commit message, commit staged changes, and push.

set -euo pipefail

usage() {
	cat <<EOF
Usage: git swcc "commit message"
Creates a git branch from the commit message, commits the staged
changes with that message, and pushes to remote.

Options:
  -h, --help    Show this help message
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
	usage
	exit 0
fi

if [[ $# -ne 1 || -z "$1" ]]; then
	usage >&2
	exit 2
fi

# Turn every run of characters that aren't valid in a branch name into a
# single hyphen, then trim hyphens from the ends.
branch=$(tr -cs '[:alnum:]/' '-' <<<"$1" | sed -E 's/^-+|-+$//g')

git switch -c "$branch"
git commit -m "$1"
git push

# vim: ts=4 sw=4
