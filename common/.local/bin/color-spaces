#!/usr/bin/env bash

# Print 256-color and 24-bit color samples to test terminal color support.

# Print one colored "::" swatch. $1 is 38 (foreground) or 48 (background),
# $2 the color spec ("5;<index>" or "2;<r>;<g>;<b>").
swatch() {
  printf '\e[%s;%sm::' "$1" "$2"
}

printf '256 color mode\n\n'

for fgbg in 38 48; do
  echo "System colors:"
  for c in {0..7}; do swatch "$fgbg" "5;$c"; done
  printf '\e[0m\n'
  for c in {8..15}; do swatch "$fgbg" "5;$c"; done
  printf '\e[0m\n\n'

  echo "Color cube, 6x6x6:"
  for g in {0..5}; do
    for r in {0..5}; do
      for b in {0..5}; do swatch "$fgbg" "5;$((16 + r * 36 + g * 6 + b))"; done
      printf '\e[0m '
    done
    echo
  done

  echo "Grayscale ramp:"
  for c in {232..255}; do swatch "$fgbg" "5;$c"; done
  printf '\e[0m\n\n'
done

printf 'Examples for the 3-byte color mode\n\n'

for fgbg in 38 48; do
  echo "Color cube"
  for g in {0..255..51}; do
    for r in {0..255..51}; do
      for b in {0..255..51}; do swatch "$fgbg" "2;$r;$g;$b"; done
      printf '\e[0m '
    done
    echo
  done

  echo "Grayscale ramp:"
  for gray in {8..255..10}; do swatch "$fgbg" "2;$gray;$gray;$gray"; done
  printf '\e[0m\n\n'
done
