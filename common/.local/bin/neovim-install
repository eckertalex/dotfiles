#!/usr/bin/env bash

# Install or update Neovim from GitHub releases.
# Supports macOS arm64 and Linux x86_64 (Fedora).
# Installs to ~/.local/share/nvim-bin and symlinks
# the binary to ~/.local/bin/nvim.
# Keeps an install log at ~/.local/share/nvim-bin/install.log.

set -euo pipefail

usage() {
  cat <<EOF
Usage: neovim-install [stable|nightly|v<version>]

Install or update Neovim from GitHub releases.

  neovim-install            # stable (default)
  neovim-install nightly    # nightly
  neovim-install v0.10.3    # specific version

Options:
  -h, --help  Show this help message
EOF
}

CHANNEL="${1:-stable}"

case "$CHANNEL" in
  -h | --help)
    usage
    exit 0
    ;;
  nightly | stable) ;;
  v[0-9]*) ;;
  *)
    usage >&2
    exit 2
    ;;
esac

OS="$(uname -s)"
ARCH="$(uname -m)"

case "$OS/$ARCH" in
  Darwin/arm64)
    TARBALL="nvim-macos-arm64.tar.gz"
    MACOS=true
    ;;
  Linux/x86_64)
    TARBALL="nvim-linux-x86_64.tar.gz"
    MACOS=false
    ;;
  *)
    echo "Error: unsupported platform $OS/$ARCH" >&2
    echo "Supported: macOS arm64, Linux x86_64" >&2
    exit 1
    ;;
esac

DOWNLOAD_URL="https://github.com/neovim/neovim/releases/download/$CHANNEL/$TARBALL"
INSTALL_DIR="$HOME/.local/share/nvim-bin"
INSTALL_LOG="$INSTALL_DIR/install.log"
BIN_DIR="$HOME/.local/bin"

# Show current version if installed
if [[ -x "$INSTALL_DIR/bin/nvim" ]]; then
  echo "Current: $("$INSTALL_DIR/bin/nvim" --version | head -1)"
else
  echo "No existing Neovim installation found"
fi

# Download and unpack next to the install dir, so the existing install is
# only replaced once the new one is fully unpacked.
mkdir -p "$(dirname "$INSTALL_DIR")"
STAGING="$(mktemp -d "$INSTALL_DIR.XXXXXX")"
trap 'rm -rf "$STAGING"' EXIT

echo "Downloading $CHANNEL from GitHub..."
curl -fsSL "$DOWNLOAD_URL" -o "$STAGING/$TARBALL"

# macOS quarantine flag prevents unsigned binaries from running
if [[ "$MACOS" == true ]]; then
  xattr -c "$STAGING/$TARBALL"
fi

mkdir "$STAGING/nvim"
tar xzf "$STAGING/$TARBALL" -C "$STAGING/nvim" --strip-components=1

echo "Installing to $INSTALL_DIR..."
if [[ -f "$INSTALL_LOG" ]]; then
  mv "$INSTALL_LOG" "$STAGING/nvim/install.log"
fi
rm -rf "$INSTALL_DIR"
mv "$STAGING/nvim" "$INSTALL_DIR"

mkdir -p "$BIN_DIR"
ln -sf "$INSTALL_DIR/bin/nvim" "$BIN_DIR/nvim"

VERSION="$("$INSTALL_DIR/bin/nvim" --version | head -1)"
echo "$(date +%Y-%m-%d) $VERSION ($CHANNEL)" >> "$INSTALL_LOG"

echo "Installed: $VERSION"
