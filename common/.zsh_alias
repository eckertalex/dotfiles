# Basic
# don't use these for serious stuff, prefer zsh/zprof or romkatv/zsh-bench
alias zbench="for i in {1..10}; do; /usr/bin/time $SHELL -lic exit; done"
alias hbench="hyperfine --warmup 3 \"$SHELL -lic exit\""

alias shellclean="rm -rf $XDG_DATA_HOME/zsh/zcompdump* $XDG_DATA_HOME/zsh/plugins $HOME/.zcompcache"

nuke-ds-store() {
  fd --hidden --no-ignore --type f --exclude node_modules --glob '.DS_Store' "${1:-.}" --exec-batch rm -v
}

alias print-fpath='print -l $fpath'
alias print-path='print -l $path'
alias hstat="history 0 | awk '{print \$2}' | sort | uniq -c | sort -n -r | head"

# lazygit
alias lzg=lazygit

# utils
alias cp="cp -vi"
alias mv="mv -vi"
alias rm="rm -vI"
alias mkdir="mkdir -pv"
alias grep="grep --color=auto"
if (( $+commands[gsed] )); then
	alias sed="gsed"
fi

# Homebrew
alias brewinfo="brew leaves | xargs brew desc"

# ls
if (( $+commands[gls] )); then
	alias ls="gls -vAF --color=auto --group-directories-first"
else
	alias ls="ls -vAF --color=auto --group-directories-first"
fi
alias ll="ls -lh"

# tree
alias tree="tree -Fav -I '.git' --dirsfirst"

# git
# A function, not an alias, so it also works inside `each`
g() { git "$@" }
compdef g=git

# Run a command in each git repo below the current dir, or only in the named ones.
#   each git pull
#   each repo-a repo-b -- git fetch
each() {
	local -a dirs
	local i=${@[(i)--]}
	if (( i <= $# )); then
		dirs=("${@[1,i-1]}"); shift $i
	else
		dirs=(*/(N))
	fi
	local d
	for d in $dirs; do
		[[ -e $d/.git ]] || continue
		print -P "%F{cyan}== ${d%/} ==%f"
		(cd "$d" && "$@")
	done
}

# vim: set ts=4 sw=4
