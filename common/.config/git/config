[branch]
	sort = -committerdate
[column]
	ui = auto
[commit]
	template = ~/.config/git/message
	verbose = true
[core]
	editor = nvim
	fsmonitor = true
	pager = delta
	untrackedCache = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[include]
	path = ~/.config/git/alias
	path = ~/.config/git/local
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.config/git/private
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
	renames = true
[log]
	abbrevCommit = true
	date = iso
[difftool]
	prompt = false
	trustExitCode = true
[merge]
	tool = fugitive
	ff = only
	conflictstyle = zdiff3
[mergetool]
	keepBackup = false
	prompt = false
; 3-way split: ours | result | theirs. :wqa marks resolved, :cq leaves it conflicted
[mergetool "fugitive"]
	cmd = nvim -c 'Gvdiffsplit!' \"$MERGED\"
	trustExitCode = true
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[rebase]
	autoSquash = true
	autoStash = true
	missingCommitsCheck = error
	updateRefs = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	sort = version:refname
[delta]
	hyperlinks = true
	line-numbers = true
	navigate = true
	syntax-theme = "ansi"

# vim: set ts=4 sw=4 filetype=gitconfig
