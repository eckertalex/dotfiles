[alias]
	s = status
	a = add
	aa = add --all
	c = commit
	cm = commit --message
	cnf = commit --amend --no-edit
	; remove last commit, keep changes staged
	uncommit = reset --soft HEAD~1
	b = branch
	bd = branch -d
	bdf = branch -D
	sw = switch
	swc = switch -c
	swm = "!git switch $(git-main-branch)"
	swcc = !git-swcc
	pl = pull
	p = push
	pf = push --force-with-lease
	rb = rebase
	rbm = "!git rebase $(git-main-branch)"
	sync = !git-sync
	; one-line log
	l = log -5 --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'
	; detailed log
	ll = log -5
	d = diff
	whorank = shortlog --summary --numbered --no-merges
	; list aliases
	alias = "!git --list-cmds=alias"

; vim: set ts=4 sw=4 filetype=gitconfig
